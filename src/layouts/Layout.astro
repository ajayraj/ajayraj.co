---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Ajay Raj - Software Engineer', 
  description = 'Personal website of Ajay Raj - Software Engineer and builder of things.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="text-white font-sans antialiased">
    <!-- Fixed parallax SVG background for entire page -->
    <div class="fixed-parallax-bg"></div>
    <slot />
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          threshold: 0.15,
          rootMargin: '0px'
        };

        const fadeInObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('fade-in-visible');
            }
          });
        }, observerOptions);

        document.querySelectorAll('.fade-in-on-scroll').forEach(el => {
          fadeInObserver.observe(el);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: linear-gradient(to bottom, #4a2c6d 0%, #5a4a70 30%, #695a75 60%, #5a5a5a 100%);
    min-height: 100vh;
    position: relative;
  }

  /* Fixed parallax background for entire page - behind content */
  .fixed-parallax-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url(/img/isometric-green.svg);
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: saturate(200%) hue-rotate(-90deg) contrast(70%) invert();
    pointer-events: none;
    z-index: -1;
  }

  /* Typography improvements */
  h1, h2, h3, h4, h5, h6 {
    letter-spacing: 0.02em;
  }

  /* Section titles reveal parallax SVG through text */
  section h2 {
    letter-spacing: 0.03em;
    position: relative;
    background-image: url(/img/isometric-green.svg);
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: saturate(220%) hue-rotate(-90deg) contrast(80%) invert() brightness(1.2);
  }

  p {
    line-height: 1.7;
  }

  /* Fade-in animations - opacity only, no transform to avoid compositor conflicts */
  .fade-in-on-scroll {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .fade-in-visible {
    opacity: 1;
  }

  /* Smooth link interactions */
  a {
    transition: color 0.2s ease;
  }
</style>
