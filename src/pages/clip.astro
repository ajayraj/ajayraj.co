---
// clip — cross-device clipboard, keyword-keyed.
// The keyword is hashed client-side (SHA-256); only the hash reaches the server.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="clip — cross-device clipboard. Drop text with a keyword; pick it up anywhere. No links, no accounts." />
  <title>clip — ajayraj.co</title>
  <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
  <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500&family=Nunito:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* ── Tokens ── */
    :root {
      --bg:         #100d18;
      --paper:      #16121f;
      --soft:       #1e1829;
      --rule:       rgba(255, 255, 255, 0.08);
      --ink:        #e8e0f0;
      --ink-soft:   #b8a8cc;
      --ink-faint:  #6e5f82;
      --warm:       #ff9966;
      --warm-light: #ffb88c;
      --warm-hover: #ffaa7a;
      --cool:       #7abf9e;
      --red:        #e07070;
      --font-serif: 'Fraunces', Georgia, serif;
      --font-sans:  'Nunito', system-ui, sans-serif;
      --font-mono:  'JetBrains Mono', 'Fira Code', monospace;
      --radius-sm:  6px;
      --radius-md:  10px;
      --radius-lg:  14px;
      --radius-pill:999px;
    }

    /* ── Reset ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--ink);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* ── Shell ── */
    .clip-shell {
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 18px 72px;
    }

    /* ── Back link ── */
    .back-link {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--ink-faint);
      text-decoration: none;
      border-bottom: 1px dotted var(--ink-faint);
      margin-bottom: 20px;
      transition: color 0.2s, border-color 0.2s;
    }
    .back-link:hover { color: var(--warm); border-color: var(--warm); }

    /* ── Hero ── */
    .clip-hero {
      text-align: center;
      margin-bottom: 28px;
    }
    .hero-title {
      font-family: var(--font-serif);
      font-size: 52px;
      font-weight: 500;
      color: #f0c9d9;
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .hero-dot { color: var(--warm); }
    .hero-sub {
      font-size: 13px;
      color: var(--ink-faint);
      margin-top: 7px;
      font-style: italic;
    }

    /* ── Main card ── */
    .clip-card {
      background: rgba(36, 24, 53, 0.78);
      border: 1px solid rgba(190, 156, 212, 0.25);
      border-radius: var(--radius-lg);
      padding: 1.5rem 1.5rem 1.25rem;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.35);
    }

    /* ── Password field ── */
    .pw-row {
      margin-bottom: 1rem;
    }
    .pw-input {
      width: 100%;
      padding: 10px 14px;
      background: var(--paper);
      border: 1px solid rgba(190, 156, 212, 0.3);
      border-radius: var(--radius-md);
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
    }
    .pw-input::placeholder { color: var(--ink-faint); }
    .pw-input:focus {
      border-color: var(--warm);
      box-shadow: 0 0 0 3px rgba(255, 153, 102, 0.12);
    }

    /* ── Mode tabs ── */
    .mode-bar {
      display: flex;
      gap: 6px;
      margin-bottom: 1.1rem;
    }
    .mode-tab {
      flex: 1;
      padding: 7px 12px;
      border-radius: var(--radius-md);
      border: 1px solid rgba(190, 156, 212, 0.2);
      background: transparent;
      color: var(--ink-faint);
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.18s, color 0.18s, border-color 0.18s;
      letter-spacing: 0.03em;
    }
    .mode-tab:hover {
      background: rgba(255, 153, 102, 0.07);
      color: var(--ink-soft);
    }
    .mode-tab.active {
      background: rgba(255, 153, 102, 0.12);
      border-color: rgba(255, 153, 102, 0.45);
      color: var(--warm-light);
    }

    /* ── Views ── */
    .view { display: flex; flex-direction: column; gap: 10px; }
    .view[hidden] { display: none; }

    /* ── Textarea ── */
    .clip-textarea {
      width: 100%;
      padding: 12px 14px;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-radius: var(--radius-md);
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: 13px;
      line-height: 1.65;
      resize: vertical;
      min-height: 180px;
      tab-size: 2;
      outline: none;
      transition: border-color 0.2s;
    }
    .clip-textarea::placeholder { color: var(--ink-faint); }
    .clip-textarea:focus { border-color: rgba(190, 156, 212, 0.5); }

    /* ── Drop footer (options + button in one row) ── */
    .drop-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* ── Burn toggle ── */
    .burn-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--ink-soft);
      cursor: pointer;
      user-select: none;
    }
    .burn-toggle input { accent-color: var(--warm); cursor: pointer; }
    .burn-icon { font-size: 15px; }

    /* ── Buttons ── */
    .btn-primary {
      padding: 9px 22px;
      background: var(--warm);
      color: #1a1020;
      border: none;
      border-radius: var(--radius-md);
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      letter-spacing: 0.02em;
      transition: background 0.18s, transform 0.1s;
      white-space: nowrap;
    }
    .btn-primary:hover   { background: var(--warm-hover); transform: translateY(-1px); }
    .btn-primary:active  { transform: translateY(0); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    .btn-secondary {
      padding: 8px 18px;
      background: rgba(190, 156, 212, 0.1);
      border: 1px solid rgba(190, 156, 212, 0.3);
      color: var(--ink-soft);
      border-radius: var(--radius-md);
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.18s, border-color 0.18s;
    }
    .btn-secondary:hover { background: rgba(190, 156, 212, 0.18); border-color: rgba(190, 156, 212, 0.5); }
    .btn-secondary:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── Messages ── */
    .msg-error {
      font-size: 13px;
      color: var(--red);
      padding: 8px 12px;
      border: 1px solid rgba(224, 112, 112, 0.3);
      border-radius: var(--radius-sm);
      background: rgba(224, 112, 112, 0.07);
    }
    .msg-success {
      font-size: 13px;
      color: var(--cool);
      padding: 8px 12px;
      border: 1px solid rgba(122, 191, 158, 0.3);
      border-radius: var(--radius-sm);
      background: rgba(122, 191, 158, 0.07);
    }

    /* ── Pick up header ── */
    .pickup-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .pickup-hint {
      font-size: 12px;
      color: var(--ink-faint);
      font-style: italic;
    }

    /* ── Clip list ── */
    #clip-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 2px;
    }
    .empty-msg {
      text-align: center;
      color: var(--ink-faint);
      font-size: 13px;
      font-style: italic;
      padding: 24px 0 8px;
    }

    /* ── Individual clip card ── */
    .clip-entry {
      background: var(--paper);
      border: 1px solid var(--rule);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .clip-entry-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 7px 12px 6px;
      border-bottom: 1px solid var(--rule);
      gap: 8px;
    }
    .clip-entry-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11.5px;
      color: var(--ink-faint);
    }
    .burn-badge {
      font-size: 11px;
      color: #e07070;
      background: rgba(224, 112, 112, 0.1);
      border: 1px solid rgba(224, 112, 112, 0.25);
      border-radius: var(--radius-pill);
      padding: 1px 7px;
      white-space: nowrap;
    }
    .clip-entry-content {
      margin: 0;
      padding: 10px 12px;
      font-family: var(--font-mono);
      font-size: 12.5px;
      line-height: 1.6;
      color: var(--ink-soft);
      white-space: pre-wrap;
      word-break: break-word;
      max-height: 220px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(255,255,255,0.15) transparent;
      tab-size: 2;
    }
    .clip-entry-actions {
      display: flex;
      gap: 6px;
      padding: 8px 12px;
      border-top: 1px solid var(--rule);
    }

    /* Small action buttons for clip entries */
    .btn-clip {
      padding: 4px 13px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--rule);
      background: var(--soft);
      color: var(--ink-soft);
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
      line-height: 1.5;
    }
    .btn-clip:hover { background: rgba(255,255,255,0.07); color: var(--ink); }
    .btn-clip-copy:hover { border-color: rgba(122, 191, 158, 0.5); color: var(--cool); }
    .btn-clip-del  { color: var(--red); border-color: rgba(224,112,112,0.2); }
    .btn-clip-del:hover { background: rgba(224,112,112,0.1); color: var(--red); border-color: rgba(224,112,112,0.45); }
    .btn-clip-del.confirming { background: rgba(224,112,112,0.15); color: var(--red); border-color: rgba(224,112,112,0.6); }

    /* ── Footer note ── */
    .clip-footer {
      margin-top: 20px;
      text-align: center;
      font-size: 11.5px;
      color: var(--ink-faint);
      line-height: 1.6;
      padding: 0 8px;
    }
    .clip-footer a { color: var(--warm); text-decoration: none; }
    .clip-footer a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      .clip-shell { padding: 16px 12px 60px; }
      .hero-title { font-size: 40px; }
      .clip-card  { padding: 1.1rem 1rem 1rem; }
      .drop-footer { flex-direction: column; align-items: flex-start; }
      .btn-primary { align-self: stretch; text-align: center; }
    }
  </style>
</head>
<body>
<div class="clip-shell">

  <a href="/" class="back-link">← ajayraj.co</a>

  <header class="clip-hero">
    <h1 class="hero-title">clip<span class="hero-dot">.</span></h1>
    <p class="hero-sub">cross-device clipboard — no link, just a keyword</p>
  </header>

  <div class="clip-card">

    <!-- Password / keyword field -->
    <div class="pw-row">
      <input
        type="text"
        id="pw"
        class="pw-input"
        placeholder="keyword or password — anything you'll remember"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <!-- Mode tabs -->
    <div class="mode-bar" role="tablist">
      <button class="mode-tab active" data-mode="drop" role="tab" aria-selected="true">↓ drop</button>
      <button class="mode-tab" data-mode="pickup" role="tab" aria-selected="false">↑ pick up</button>
    </div>

    <!-- Drop view -->
    <div id="view-drop" class="view">
      <textarea
        id="drop-content"
        class="clip-textarea"
        placeholder="paste text, code, commands, anything…"
        spellcheck="false"
        rows="10"
      ></textarea>
      <div class="drop-footer">
        <label class="burn-toggle">
          <input type="checkbox" id="burn-check" />
          <span class="burn-icon" aria-hidden="true">🔥</span>
          burn after reading
        </label>
        <button id="drop-btn" class="btn-primary">drop ↓</button>
      </div>
      <div id="drop-error" class="msg-error" hidden></div>
      <div id="drop-success" class="msg-success" hidden>
        dropped ✓ — open clip on any device and enter the same keyword to pick it up
      </div>
    </div>

    <!-- Pick up view -->
    <div id="view-pickup" class="view" hidden>
      <div class="pickup-header">
        <p class="pickup-hint">clips stored for this keyword</p>
        <button id="refresh-btn" class="btn-secondary">↺ refresh</button>
      </div>
      <div id="pickup-error" class="msg-error" hidden></div>
      <div id="clip-list"></div>
    </div>

  </div>

  <footer class="clip-footer">
    <p>
      your keyword is hashed in the browser before anything is sent —
      the plaintext never leaves your device.
      <a href="/" title="back to ajayraj.co">← home</a>
    </p>
  </footer>

</div>

<script is:inline>
(function () {
'use strict';

/* ── Config ── */
var API = (window.location.hostname === 'localhost'
  ? 'http://localhost:8787'
  : '') + '/api/clip';

/* ── SHA-256 hex (client-side, no plaintext sent) ── */
async function sha256hex(str) {
  var data = new TextEncoder().encode('clip:' + str);
  var buf  = await crypto.subtle.digest('SHA-256', data);
  return Array.from(new Uint8Array(buf))
    .map(function (b) { return b.toString(16).padStart(2, '0'); })
    .join('');
}

/* ── Element refs ── */
var pwInput      = document.getElementById('pw');
var viewDrop     = document.getElementById('view-drop');
var viewPickup   = document.getElementById('view-pickup');
var dropContent  = document.getElementById('drop-content');
var burnCheck    = document.getElementById('burn-check');
var dropBtn      = document.getElementById('drop-btn');
var dropError    = document.getElementById('drop-error');
var dropSuccess  = document.getElementById('drop-success');
var refreshBtn   = document.getElementById('refresh-btn');
var pickupError  = document.getElementById('pickup-error');
var clipList     = document.getElementById('clip-list');

/* ── Helpers ── */
function showErr(el, msg) {
  el.textContent = msg;
  el.hidden = false;
}
function hideMsg(el) { el.hidden = true; }

function escHtml(s) {
  return String(s || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function relDate(iso) {
  if (!iso) return '';
  var ms   = Date.now() - new Date(iso).getTime();
  var mins = Math.floor(ms / 60000);
  var hrs  = Math.floor(ms / 3600000);
  var days = Math.floor(ms / 86400000);
  if (mins < 1)  return 'just now';
  if (hrs  < 1)  return mins + 'm ago';
  if (days < 1)  return hrs + 'h ago';
  if (days < 7)  return days + 'd ago';
  if (days < 30) return Math.floor(days / 7) + 'w ago';
  return Math.floor(days / 30) + 'mo ago';
}

/* ── Mode switching ── */
var tabs = document.querySelectorAll('.mode-tab');
tabs.forEach(function (tab) {
  tab.addEventListener('click', function () {
    var mode = tab.dataset.mode;
    tabs.forEach(function (t) {
      t.classList.toggle('active', t === tab);
      t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
    });
    viewDrop.hidden   = mode !== 'drop';
    viewPickup.hidden = mode !== 'pickup';
    if (mode === 'pickup' && pwInput.value.trim()) {
      fetchClips();
    }
  });
});

/* ── Drop ── */
dropBtn.addEventListener('click', async function () {
  hideMsg(dropError);
  hideMsg(dropSuccess);

  var pw      = pwInput.value.trim();
  var content = dropContent.value; // preserve trailing newlines / indentation
  if (content.endsWith('\n')) content = content.replace(/\n+$/, '');

  if (!pw)      { showErr(dropError, 'enter a keyword first'); return; }
  if (!content) { showErr(dropError, 'paste something first'); return; }

  var key = await sha256hex(pw);
  var burn = burnCheck.checked;

  dropBtn.textContent = 'dropping…';
  dropBtn.disabled    = true;

  try {
    var res = await fetch(API, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ key: key, content: content, burn: burn }),
    });
    if (!res.ok) {
      var d = await res.json().catch(function () { return {}; });
      showErr(dropError, d.error || 'something went wrong (HTTP ' + res.status + ')');
      return;
    }
    dropContent.value = '';
    burnCheck.checked = false;
    dropSuccess.hidden = false;
    setTimeout(function () { dropSuccess.hidden = true; }, 5000);
  } catch (e) {
    showErr(dropError, 'network error — is the API reachable?');
  } finally {
    dropBtn.textContent = 'drop ↓';
    dropBtn.disabled    = false;
  }
});

/* Allow Cmd/Ctrl+Enter in textarea to drop */
dropContent.addEventListener('keydown', function (e) {
  if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
    e.preventDefault();
    dropBtn.click();
  }
});

/* ── Pick up ── */
async function fetchClips() {
  hideMsg(pickupError);
  clipList.innerHTML = '';

  var pw = pwInput.value.trim();
  if (!pw) {
    showErr(pickupError, 'enter a keyword to fetch clips');
    return;
  }

  refreshBtn.textContent = '↺ fetching…';
  refreshBtn.disabled    = true;

  var key;
  try {
    key = await sha256hex(pw);
    var res = await fetch(API + '?key=' + encodeURIComponent(key));
    if (!res.ok) {
      var d = await res.json().catch(function () { return {}; });
      showErr(pickupError, d.error || 'fetch failed (HTTP ' + res.status + ')');
      return;
    }
    var clips = await res.json();
    renderClipList(clips, key);
  } catch (e) {
    showErr(pickupError, 'network error — is the API reachable?');
  } finally {
    refreshBtn.textContent = '↺ refresh';
    refreshBtn.disabled    = false;
  }
}

refreshBtn.addEventListener('click', fetchClips);

/* Allow Enter in password field to fetch when in pick-up mode */
pwInput.addEventListener('keydown', function (e) {
  if (e.key === 'Enter' && !viewPickup.hidden) {
    fetchClips();
  }
});

/* ── Render clip list ── */
function renderClipList(clips, key) {
  if (!clips || clips.length === 0) {
    clipList.innerHTML = '<p class="empty-msg">no clips for this keyword.</p>';
    return;
  }

  var html = '';
  clips.forEach(function (clip) {
    html +=
      '<div class="clip-entry" data-id="' + escHtml(clip.id) + '">' +
        '<div class="clip-entry-header">' +
          '<div class="clip-entry-meta">' +
            '<span>' + relDate(clip.created_at) + '</span>' +
            (clip.burn ? '<span class="burn-badge">🔥 burn once</span>' : '') +
          '</div>' +
        '</div>' +
        '<pre class="clip-entry-content">' + escHtml(clip.content) + '</pre>' +
        '<div class="clip-entry-actions">' +
          '<button class="btn-clip btn-clip-copy" data-id="' + escHtml(clip.id) + '" data-burn="' + clip.burn + '">copy</button>' +
          '<button class="btn-clip btn-clip-del"  data-id="' + escHtml(clip.id) + '">delete</button>' +
        '</div>' +
      '</div>';
  });
  clipList.innerHTML = html;

  /* Wire copy buttons */
  clipList.querySelectorAll('.btn-clip-copy').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var id      = btn.dataset.id;
      var isBurn  = btn.dataset.burn === 'true';
      var entry   = btn.closest('.clip-entry');
      var content = entry.querySelector('.clip-entry-content').textContent;

      try {
        await navigator.clipboard.writeText(content);
      } catch (e) {
        /* Fallback for non-HTTPS or blocked clipboard */
        var ta = document.createElement('textarea');
        ta.value = content;
        ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (_) {}
        document.body.removeChild(ta);
      }

      btn.textContent = 'copied!';

      if (isBurn) {
        /* Burn: delete from server then remove from DOM */
        try {
          await fetch(API + '/' + encodeURIComponent(id) + '?key=' + encodeURIComponent(key), {
            method: 'DELETE',
          });
        } catch (_) {}
        entry.remove();
        if (!clipList.querySelector('.clip-entry')) {
          clipList.innerHTML = '<p class="empty-msg">all clips consumed.</p>';
        }
      } else {
        setTimeout(function () { btn.textContent = 'copy'; }, 1600);
      }
    });
  });

  /* Wire delete buttons (two-click confirm) */
  clipList.querySelectorAll('.btn-clip-del').forEach(function (btn) {
    var confirmTimer = null;
    btn.addEventListener('click', async function () {
      if (!btn.classList.contains('confirming')) {
        /* First click: arm confirmation */
        btn.classList.add('confirming');
        btn.textContent = 'sure?';
        confirmTimer = setTimeout(function () {
          btn.classList.remove('confirming');
          btn.textContent = 'delete';
        }, 3000);
        return;
      }
      /* Second click: confirmed */
      clearTimeout(confirmTimer);
      btn.textContent = 'deleting…';
      btn.disabled    = true;

      var id    = btn.dataset.id;
      var entry = btn.closest('.clip-entry');

      try {
        var res = await fetch(API + '/' + encodeURIComponent(id) + '?key=' + encodeURIComponent(key), {
          method: 'DELETE',
        });
        if (res.ok) {
          entry.remove();
          if (!clipList.querySelector('.clip-entry')) {
            clipList.innerHTML = '<p class="empty-msg">no clips for this keyword.</p>';
          }
        } else {
          btn.classList.remove('confirming');
          btn.textContent = 'delete';
          btn.disabled    = false;
        }
      } catch (e) {
        btn.classList.remove('confirming');
        btn.textContent = 'delete';
        btn.disabled    = false;
      }
    });
  });
}

})();
</script>
</body>
</html>
