---
// Featured projects showcasing technical depth and systems thinking
const projects = [
  {
    title: "CNC Machine Build",
    description: "Designed and built a CNC machine based on the OpenBuilds Sphinx platform for hardware prototyping and device fabrication. Now using it for rapid prototyping of physical products and custom mechanical parts.",
    tech: ["CNC/CAM", "Mechanical Design", "G-code", "Hardware Integration"],
    context: "Purpose-built for device prototyping and hardware development"
  },
  {
    title: "icebergify",
    description: "Viral Spotify stats visualizer built to handle massive traffic spikes.",
    tech: ["Python", "Flask", "NGINX", "Gunicorn", "Spotify API"],
    demo: "https://icebergify.com",
    context: "Featured on CNET and Lifehacker",
    impact: "15M+"
  },
  {
    title: "YAVS",
    description: "Full-stack video platform with ML-powered insights. Built end-to-end: video processing pipeline, async task queue, wordcloud generation, and automatic categorization using NLP. Handles concurrent uploads, transcoding, and serves thousands of videos.",
    tech: ["Python", "Django", "Spacy", "NGINX", "PostgreSQL", "Redis", "Docker"],
    github: "https://github.com/ajayraj/yavs",
    context: "Production-ready architecture with Docker orchestration"
  },
  {
    title: "hive-fs",
    description: "Peer-to-peer distributed filesystem using DHT and FUSE. Designed the networking layer, consensus protocol, and filesystem interface. Every node shares storage—files automatically replicate and remain accessible even as nodes join/leave.",
    tech: ["C++", "OpenDHT", "FUSE", "Distributed Systems"],
    github: "https://github.com/ajayraj/hive-fs",
    context: "Deep dive into distributed systems and low-level networking for senior design"
  },
  {
    title: "Wireless Plant Research System",
    description: "Custom embedded hardware for botanical research. Integrated GPS, thermal imaging, IR spectrometry, and resistivity sensors into a handheld device. Designed data pipeline: sensor → Arduino → real-time display → geotagged CSV export to research servers.",
    tech: ["C", "Arduino", "Embedded Systems", "Hardware Integration"],
    context: "Built for university research lab"
  }
];
---

<section id="projects" class="pt-14 pb-14 projects-block section-layer">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold mb-6 text-center text-pink-200">Projects</h2>

    <div class="projects-grid grid grid-cols-1 lg:grid-cols-6 gap-4">
      {projects.map((project, i) => (
        <div class={`project-card flex flex-col fade-in-on-scroll project-card-${i}`}>
          <!-- Content -->
          <div class="card-block flex-1 p-4">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-xl font-bold flex-1">
                {project.demo ? (
                  <a href={project.demo} target="_blank" rel="noopener noreferrer" class="card-title-link">
                    {project.title}
                  </a>
                ) : (
                  <span class="card-title-text">{project.title}</span>
                )}
              </h3>
              {project.impact && (
                <div class="impact-badge">
                  {project.impact}
                  <span class="impact-label">users</span>
                </div>
              )}
            </div>
            
            {project.context && (
              <p class="project-context text-sm mb-2 italic">
                {project.context}
              </p>
            )}
            
            <p class="text-white leading-relaxed mb-3 text-sm">
              {project.description}
            </p>
            
            {project.github && (
              <p class="mt-auto">
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="card-link text-sm">
                  View Source →
                </a>
              </p>
            )}
          </div>
          
          <!-- Tech footer -->
          <div class="card-footer p-3">
            <small class="text-gray-600 text-sm">
              {project.tech.join(' • ')}
            </small>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 text-center fade-in-on-scroll">
      <a href="https://github.com/ajayraj" target="_blank" rel="noopener noreferrer" class="github-link text-pink-200 text-lg">
        more on github
      </a>
    </div>
  </div>
</section>

<style>
  /* Top stop matches the *exact* end-of-previous-section colour (the
     .approach-section gradient ends at rgba(180,120,90,0.4) over the html
     bg), then ramps into solid warm orange and finally to gray. Picking up
     the same colour the seam ends with makes the boundary disappear. */
  .projects-block {
    background: linear-gradient(
      to bottom,
      rgba(180, 120, 90, 0.4) 0%,
      rgba(180, 120, 90, 0.7) 8%,
      rgba(176, 119, 68, 0.95) 28%,
      #b07744 42%,
      #8c6360 65%,
      #6a5a5a 85%,
      #5a5a5a 100%
    );
  }

  /* 3 on top, 2 centered on bottom — 6-col grid so bottom pair is symmetrical */
  @media (min-width: 1024px) {
    .projects-grid .project-card-0 { grid-column: 1 / 3; }
    .projects-grid .project-card-1 { grid-column: 3 / 5; }
    .projects-grid .project-card-2 { grid-column: 5 / 7; }
    .projects-grid .project-card-3 { grid-column: 2 / 4; }
    .projects-grid .project-card-4 { grid-column: 4 / 6; }
  }

  .card-block {
    background-color: #4d4d4d;
    border-radius: 1.25rem 1.25rem 0 0;
    transition: all 0.3s ease;
    box-shadow: 8px 8px rgba(114, 114, 114, 0.6);
  }

  .card-block:hover {
    background-color: rgba(90, 90, 90, 0.85) !important;
    color: #ffffff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    transform: scale(1.02);
    border: 1px solid rgba(255, 160, 122, 0.3);
  }

  .card-block h3 {
    letter-spacing: 0.015em;
  }

  .impact-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.2), rgba(255, 160, 122, 0.2));
    border: 1px solid rgba(255, 160, 122, 0.3);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-weight: 700;
    font-size: 1.25rem;
    color: #ffa07a;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: 0.75rem;
  }

  .impact-label {
    font-size: 0.65rem;
    font-weight: 500;
    color: rgba(255, 160, 122, 0.8);
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-block p {
    line-height: 1.7;
  }

  .card-title-link {
    color: #7dd4aa;
    font-family: verdana, sans-serif;
    text-decoration: none;
    position: relative;
  }

  .card-title-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: -2px;
    left: 0;
    background-color: #7dd4aa;
    transition: width 0.3s ease;
  }

  .card-title-link:hover::after {
    width: 100%;
  }

  .card-title-text {
    color: #d8a5e8;
    font-family: verdana, sans-serif;
  }

  .card-link {
    color: #ebc9d0;
    font-weight: 500;
    text-decoration: none;
    position: relative;
  }

  .card-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -1px;
    left: 0;
    background-color: #ffa07a;
    transition: width 0.3s ease;
  }

  .card-link:hover {
    color: #ffa07a;
  }

  .card-link:hover::after {
    width: 100%;
  }

  .project-context {
    color: #ffb88c;
    font-weight: 500;
  }

  .card-footer {
    border-top: 1px solid lightgrey;
    background-color: lightgrey;
    border-radius: 0 0 0.5rem 0.5rem;
    box-shadow: 8px 8px rgba(114, 114, 114, 0.6);
  }

  .github-link {
    position: relative;
    text-decoration: none;
    transition: color 0.3s ease;
    display: inline-block;
  }

  /* Faint underline always visible */
  .github-link::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 1px;
    bottom: -2px;
    left: 0;
    background-color: rgba(255, 160, 122, 0.3);
  }

  /* Expanding underline on hover */
  .github-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #ffa07a;
    box-shadow: 0 0 8px rgba(255, 160, 122, 0.6);
    transition: width 0.3s ease;
  }

  .github-link:hover {
    color: #ffa07a;
  }

  .github-link:hover::after {
    width: 100%;
  }
</style>
