---
// Footer component
---

<footer class="footer-block section-layer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center">
      <p class="footer-availability">
        san diego / remote · <a href="mailto:ajay@ajayraj.co">ajay@ajayraj.co</a>
      </p>
      <a
        href="https://github.com/ajayraj/ajayraj.co"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >
        no templates here<br />
        <span class="copyleft">&copy;</span> ajay raj
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-block {
    width: 100%;
    min-height: 150px;
    background-color: #595959;
    display: flex;
    align-items: center;
  }

  .footer-availability {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }
  .footer-availability a {
    color: #ffa07a;
    text-decoration: none;
    border-bottom: 1px dotted rgba(255, 160, 122, 0.5);
    transition: color 0.2s, border-color 0.2s;
  }
  .footer-availability a:hover {
    color: #ff8c42;
    border-bottom-color: #ff8c42;
  }

  .footer-link {
    color: rgba(223, 165, 238, 0.726);
    font-size: 1.25rem;
    font-weight: 400;
    text-decoration: none;
    transition: color 0.3s ease;
    position: relative;
    display: inline-block;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    background-color: rgba(223, 165, 238, 0.9);
    transition: width 0.3s ease;
  }

  .footer-link:hover {
    color: rgba(223, 165, 238, 0.9);
  }

  .footer-link:hover::after {
    width: 80%;
  }

  .copyleft {
    display: inline-block;
    transform: rotate(180deg) translateY(-4px);
    font-size: 1.875rem;
  }
</style>
