---
// Easter egg tools sidebar — fixed bottom-right floating launcher
---

<div class="tools-egg" id="tools-egg">
  <div class="tools-drawer" id="tools-drawer" style="display:none">
    <div class="tools-drawer-label">tools</div>
    <ul class="tools-list">
      <li>
        <a href="https://cs-anki.ajayraj.co" target="_blank" rel="noopener noreferrer" class="tool-link">
          <span class="tool-icon">⌗</span>
          <span class="tool-name">cs-anki</span>
          <span class="tool-desc">algorithm flashcards</span>
        </a>
      </li>
    </ul>
  </div>

  <button class="tools-fab" id="tools-fab" aria-label="Tools" aria-expanded="false">
    <span class="tools-fab-icon">⌗</span>
  </button>
</div>

<style>
  .tools-egg {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .tools-fab {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(60, 40, 80, 0.55);
    border: 1px solid rgba(223, 165, 238, 0.18);
    color: rgba(223, 165, 238, 0.5);
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
    line-height: 1;
  }

  .tools-fab:hover {
    background: rgba(80, 50, 110, 0.75);
    border-color: rgba(223, 165, 238, 0.4);
    color: rgba(223, 165, 238, 0.9);
    transform: scale(1.08);
  }

  .tools-fab.active {
    background: rgba(80, 50, 110, 0.75);
    border-color: rgba(223, 165, 238, 0.4);
    color: rgba(223, 165, 238, 0.9);
    transform: scale(1.08) rotate(45deg);
  }

  .tools-drawer {
    background: rgba(36, 24, 53, 0.88);
    border: 1px solid rgba(223, 165, 238, 0.15);
    border-radius: 12px;
    padding: 12px 14px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    min-width: 180px;
    animation: drawerIn 0.18s ease forwards;
  }

  @keyframes drawerIn {
    from { opacity: 0; transform: scale(0.92) translateY(6px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  .tools-drawer-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(223, 165, 238, 0.35);
    margin-bottom: 8px;
    font-weight: 600;
  }

  .tools-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tool-link {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .tool-link:hover {
    background: rgba(223, 165, 238, 0.08);
  }

  .tool-icon {
    font-size: 13px;
    color: rgba(223, 165, 238, 0.55);
    flex-shrink: 0;
  }

  .tool-name {
    font-size: 13px;
    font-weight: 500;
    color: rgba(223, 165, 238, 0.85);
    font-family: 'JetBrains Mono', monospace;
  }

  .tool-desc {
    font-size: 10px;
    color: rgba(223, 165, 238, 0.35);
  }

  @media (max-width: 480px) {
    .tools-egg {
      bottom: 1.25rem;
      right: 1.25rem;
    }
  }
</style>

<script>
  const egg    = document.getElementById('tools-egg');
  const fab    = document.getElementById('tools-fab');
  const drawer = document.getElementById('tools-drawer');

  function open() {
    if (!drawer || !fab) return;
    drawer.style.display = 'block';
    fab.classList.add('active');
    fab.setAttribute('aria-expanded', 'true');
  }

  function close() {
    if (!drawer || !fab) return;
    drawer.style.display = 'none';
    fab.classList.remove('active');
    fab.setAttribute('aria-expanded', 'false');
  }

  fab?.addEventListener('click', (e) => {
    e.stopPropagation();
    drawer?.style.display === 'none' ? open() : close();
  });

  document.addEventListener('click', (e) => {
    if (!egg?.contains(e.target as Node)) close();
  });
</script>
