---
// Hero section with parallax SVG background
---

<section class="relative min-h-screen overflow-hidden">
  <!-- Parallax background with SVG and clip-path -->
  <div class="parallax-container absolute inset-0">
    <div class="parallax-bg"></div>
  </div>

  <!-- Content over parallax - split by diagonal -->
  <div class="relative z-10 min-h-screen flex flex-col justify-between px-4 sm:px-12 lg:px-16">
    <!-- Top left: Name and tagline -->
    <div class="mt-[25vh] max-w-xl">
      <h1 class="welcome-text text-4xl sm:text-5xl lg:text-6xl font-light mb-6">
        <span class="styled-name">Ajay Raj</span>
      </h1>
      <p class="hero-subtitle text-lg sm:text-xl lg:text-2xl font-light text-white/90 leading-relaxed">
        Let's talk <span class="rotating-text"></span>
      </p>
    </div>

    <!-- Bottom center: Social buttons -->
    <div class="social-buttons-container">
      <a 
        href="https://github.com/ajayraj" 
        target="_blank"
        rel="noopener noreferrer"
        class="social-button social-button-1"
        aria-label="GitHub"
      >
        <img src="/img/GitHub-Mark-Light-64px.png" alt="GitHub" class="w-10 h-10" />
      </a>
      
      <a 
        href="https://linkedin.com/in/ajayjonathanraj" 
        target="_blank"
        rel="noopener noreferrer"
        class="social-button social-button-2"
        aria-label="LinkedIn"
      >
        <img src="/img/linkedin.svg" alt="LinkedIn" class="w-10 h-10 brightness-0 invert" />
      </a>
      
      <a 
        href="mailto:ajay@ajayraj.co"
        class="social-button social-button-3"
        aria-label="Email"
      >
        <img src="/img/at.svg" alt="Email" class="w-10 h-10 brightness-0 invert" />
      </a>
    </div>
  </div>
  <!-- Subtle color transition overlay for the solid background area (bottom-right) -->
  <div class="color-transition-overlay"></div>
  
  <!-- Scroll indicator arrow -->
  <div class="scroll-indicator">
    <svg width="30" height="40" viewBox="0 0 30 40" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="glow">
          <feGaussianBlur stdDeviation="2.5" result="coloredBlur"/>
          <feMerge>
            <feMergeNode in="coloredBlur"/>
            <feMergeNode in="SourceGraphic"/>
          </feMerge>
        </filter>
      </defs>
      <!-- Minimal geometric chevrons -->
      <path d="M 8 8 L 15 15 L 22 8" 
            stroke="#ff9966" 
            stroke-width="1.5" 
            fill="none" 
            stroke-linecap="square"
            filter="url(#glow)"
            opacity="0.6"/>
      <path d="M 8 18 L 15 25 L 22 18" 
            stroke="#ff9966" 
            stroke-width="1.5" 
            fill="none" 
            stroke-linecap="square"
            filter="url(#glow)"
            opacity="0.8"/>
      <path d="M 8 28 L 15 35 L 22 28" 
            stroke="#ff9966" 
            stroke-width="2" 
            fill="none" 
            stroke-linecap="square"
            filter="url(#glow)"/>
    </svg>
  </div>
</section>

<style>
  .parallax-container {
    height: 100vh;
    width: 100%;
  }

  .parallax-bg {
    background-image: url(/img/isometric-green.svg);
    filter: saturate(200%) hue-rotate(-90deg) contrast(70%) invert();
    min-height: 100vh;
    width: 100%;
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    clip-path: polygon(0 0, 0% 100%, 100% 0);
  }

  .welcome-text {
    color: white;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .styled-name {
    font-weight: 400;
    color: white;
    text-shadow: 0 0 20px rgba(255, 160, 122, 0.25), 0 0 40px rgba(255, 140, 66, 0.15);
  }

  .hero-subtitle {
    letter-spacing: 0.01em;
  }

  .rotating-text {
    color: #ff9966;
    display: inline-block;
    min-width: 250px;
    font-family: monospace;
    letter-spacing: 0.02em;
  }

  .social-buttons-container {
    display: flex;
    gap: 2rem;
    justify-content: center;
    align-items: center;
    padding-bottom: 3rem;
  }

  .social-button {
    padding: 0.875rem;
    border-radius: 50%;
    background: rgba(68, 221, 101, 0.5);
    filter: hue-rotate(190deg) saturate(100%) brightness(150%);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
  }

  .social-button:hover {
    transform: scale(1.1);
    filter: hue-rotate(190deg) saturate(150%) brightness(180%);
    box-shadow: 0 8px 24px rgba(190, 156, 212, 0.6);
    opacity: 1;
  }

  .social-button:focus-visible {
    outline: 2px solid rgba(255, 160, 122, 0.8);
    outline-offset: 4px;
  }

  @media (max-width: 768px) {
    .social-buttons-container {
      gap: 1rem;
      padding-bottom: 2rem;
    }
  }

  @media (max-width: 480px) {
    .social-button {
      padding: 0.7rem;
    }

    .social-button img {
      width: 2rem !important;
      height: 2rem !important;
    }
  }

  @media (max-width: 640px) {
    .parallax-bg {
      background-attachment: scroll;
    }
  }

  .color-transition-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, transparent 0%, rgba(90, 90, 90, 0.15) 40%, rgba(90, 90, 90, 0.4) 75%, rgba(90, 90, 90, 0.95) 100%);
    clip-path: polygon(100% 0, 0% 100%, 100% 100%);
    pointer-events: none;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 8vh;
    left: 2%;
    opacity: 0.7;
    animation: floatArrow 3s ease-in-out infinite;
    cursor: pointer;
    z-index: 20;
    transition: opacity 0.3s ease;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  @keyframes floatArrow {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(10px);
    }
  }

  @media (max-width: 768px) {
    .scroll-indicator {
      left: 50%;
      transform: translateX(-50%);
      bottom: 8vh;
    }
  }
</style>

<script>
  const phrases = [
    'local compute',
    'hardware-software co-design',
    'computational biology',
    'self-sustaining systems',
    'prototyping at scale',
    'system reliability',
    'medical devices',
    'embedded intelligence',
    'tokenization hacks'
  ];

  const chars = 'abcdefghijklmnopqrstuvwxyz-';
  let currentIndex = 0;
  const rotatingText = document.querySelector('.rotating-text');

  function scrambleText(finalText) {
    const length = finalText.length;
    let iterations = 0;
    const maxIterations = length;

    const interval = setInterval(() => {
      rotatingText.textContent = finalText
        .split('')
        .map((char, index) => {
          if (index < iterations) {
            return finalText[index];
          }
          if (char === ' ' || char === '-') return char;
          return chars[Math.floor(Math.random() * chars.length)];
        })
        .join('');

      iterations += 1;

      if (iterations > maxIterations) {
        clearInterval(interval);
        rotatingText.textContent = finalText;
      }
    }, 30);
  }

  function updateText() {
    currentIndex = (currentIndex + 1) % phrases.length;
    scrambleText(phrases[currentIndex]);
  }

  // Initialize with first phrase
  scrambleText(phrases[0]);

  // Rotate every 4.5 seconds
  setInterval(updateText, 4500);

  // Scroll indicator click handler
  document.querySelector('.scroll-indicator')?.addEventListener('click', (e) => {
    e.preventDefault();
    const aboutSection = document.querySelector('#about');
    if (aboutSection) {
      aboutSection.scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
      });
    }
  });
</script>
