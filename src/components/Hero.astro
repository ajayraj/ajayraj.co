---
// Hero section with parallax SVG background
---

<section class="hero-section relative min-h-screen overflow-hidden">
  <div class="parallax-container absolute inset-0">
    <div class="parallax-clip">
      <div class="parallax-bg"></div>
    </div>
    <div class="parallax-clip-bottom">
      <div class="parallax-bg-bottom"></div>
    </div>
  </div>

  <div class="relative hero-spacer" style="z-index: 3;">
    <div class="hero-text-content">
      <h1 class="welcome-text text-4xl sm:text-5xl lg:text-6xl font-light mb-6">
        <span class="styled-name">Ajay Raj</span>
      </h1>
      <p class="hero-subtitle text-lg sm:text-xl lg:text-2xl font-light text-white/90 leading-relaxed">
        Let's talk <span class="rotating-text"></span>
      </p>
    </div>

    <div class="scroll-indicator">
      <svg width="30" height="40" viewBox="0 0 30 40" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="glow">
            <feGaussianBlur stdDeviation="2.5" result="coloredBlur"/>
            <feMerge>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
        <path d="M 8 8 L 15 15 L 22 8" stroke="#ff9966" stroke-width="1.5" fill="none" stroke-linecap="square" filter="url(#glow)" opacity="0.6"/>
        <path d="M 8 18 L 15 25 L 22 18" stroke="#ff9966" stroke-width="1.5" fill="none" stroke-linecap="square" filter="url(#glow)" opacity="0.8"/>
        <path d="M 8 28 L 15 35 L 22 28" stroke="#ff9966" stroke-width="2" fill="none" stroke-linecap="square" filter="url(#glow)"/>
      </svg>
    </div>

    <div class="social-buttons-container">
      <a href="https://github.com/ajayraj" target="_blank" rel="noopener noreferrer" class="social-button" aria-label="GitHub">
        <svg class="w-10 h-10" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://linkedin.com/in/ajayjonathanraj" target="_blank" rel="noopener noreferrer" class="social-button" aria-label="LinkedIn">
        <img src="/img/linkedin.svg" alt="LinkedIn" class="w-10 h-10 brightness-0 invert" />
      </a>
      <a href="mailto:ajay@ajayraj.co" class="social-button" aria-label="Email">
        <img src="/img/at.svg" alt="Email" class="w-10 h-10 brightness-0 invert" />
      </a>
    </div>
  </div>

  <div class="color-transition-overlay"></div>
</section>

<style>
  .parallax-container {
    height: 100vh;
    width: 100%;
  }

  .parallax-clip {
    position: absolute;
    inset: 0;
    -webkit-clip-path: polygon(0 0, 0% 100%, 100% 0);
    clip-path: polygon(0 0, 0% 100%, 100% 0);
  }

  .parallax-clip-bottom {
    position: absolute;
    inset: 0;
    -webkit-clip-path: polygon(100% 0, 0% 100%, 100% 100%);
    clip-path: polygon(100% 0, 0% 100%, 100% 100%);
  }

  .parallax-bg,
  .parallax-bg-bottom {
    background-image: url(/img/isometric-green.svg);
    min-height: 100vh;
    width: 100%;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .parallax-bg {
    filter: saturate(200%) hue-rotate(-90deg) contrast(70%) invert();
  }

  /* Faint SVG painted directly under the diagonal so the effect renders
     identically in Safari (which doesn't reliably composite the body's
     z-index:-1 fixed background through the section's stacking context). */
  .parallax-bg-bottom {
    opacity: 0.25;
  }

  .hero-section {
    position: relative;
    z-index: 2;
    background: linear-gradient(to bottom, #4a2c6d 0%, #5a4a70 60%, #695a75 100%);
  }

  .hero-spacer {
    min-height: 100vh;
  }

  .hero-text-content {
    position: absolute;
    top: 25vh;
    left: 4rem;
    max-width: 40rem;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 8vh;
    left: 3%;
    opacity: 0.7;
    animation: floatArrow 3s ease-in-out infinite;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  .welcome-text {
    color: white;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .styled-name {
    font-weight: 400;
    color: white;
    text-shadow: 0 0 20px rgba(255, 160, 122, 0.25), 0 0 40px rgba(255, 140, 66, 0.15);
  }

  .hero-subtitle {
    letter-spacing: 0.01em;
  }

  .rotating-text {
    color: #ff9966;
    display: inline-block;
    min-width: 250px;
    font-family: monospace;
    letter-spacing: 0.02em;
  }

  .social-buttons-container {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 2rem;
    justify-content: center;
    align-items: center;
  }

  .social-button {
    padding: 0.875rem;
    border-radius: 50%;
    background: rgba(68, 221, 101, 0.5);
    filter: hue-rotate(190deg) saturate(100%) brightness(150%);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
  }

  .social-button:hover {
    transform: scale(1.1);
    filter: hue-rotate(190deg) saturate(150%) brightness(180%);
    box-shadow: 0 8px 24px rgba(190, 156, 212, 0.6);
    opacity: 1;
  }

  .social-button:focus-visible {
    outline: 2px solid rgba(255, 160, 122, 0.8);
    outline-offset: 4px;
  }

  @media (max-width: 768px) {
    .hero-text-content {
      left: 1rem;
      max-width: calc(100% - 2rem);
    }

    .social-buttons-container {
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .social-button {
      padding: 0.7rem;
    }

    .social-button img {
      width: 2rem !important;
      height: 2rem !important;
    }
  }

  @media (max-width: 640px) {
    .parallax-bg {
      background-attachment: scroll;
    }
  }

  .color-transition-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, transparent 0%, rgba(90, 90, 90, 0.15) 40%, rgba(90, 90, 90, 0.4) 75%, rgba(90, 90, 90, 0.95) 100%);
    clip-path: polygon(100% 0, 0% 100%, 100% 100%);
    pointer-events: none;
  }

  @keyframes floatArrow {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(10px);
    }
  }

  @media (max-width: 768px) {
    .scroll-indicator {
      left: 5%;
      bottom: 20vh;
    }
  }
</style>

<script>
  const phrases = [
    'local compute',
    'hardware-software co-design',
    'computational biology',
    'self-sustaining systems',
    'prototyping at scale',
    'system reliability',
    'medical devices',
    'embedded intelligence',
    'your next project',
    'tokenization hacks'
  ];

  const chars = 'abcdefghijklmnopqrstuvwxyz-';
  let currentIndex = 0;
  const rotatingText = document.querySelector('.rotating-text');

  function scrambleText(finalText) {
    let iterations = 0;
    const maxIterations = finalText.length;

    const interval = setInterval(() => {
      rotatingText.textContent = finalText
        .split('')
        .map((char, index) => {
          if (index < iterations) {
            return finalText[index];
          }
          if (char === ' ' || char === '-') return char;
          return chars[Math.floor(Math.random() * chars.length)];
        })
        .join('');

      iterations += 1;

      if (iterations > maxIterations) {
        clearInterval(interval);
        rotatingText.textContent = finalText;
      }
    }, 30);
  }

  function updateText() {
    currentIndex = (currentIndex + 1) % phrases.length;
    scrambleText(phrases[currentIndex]);
  }

  // Initialize with first phrase
  scrambleText(phrases[0]);

  // Rotate every 3.5 seconds
  setInterval(updateText, 3500);

  // Scroll indicator click handler
  document.querySelector('.scroll-indicator')?.addEventListener('click', (e) => {
    e.preventDefault();
    const aboutSection = document.querySelector('#about');
    if (aboutSection) {
      aboutSection.scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
      });
    }
  });
</script>
