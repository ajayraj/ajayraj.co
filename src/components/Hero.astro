---
// Hero section with parallax SVG background
---

<section class="relative min-h-screen overflow-hidden">
  <!-- Parallax background with SVG and clip-path -->
  <div class="parallax-container absolute inset-0">
    <div class="parallax-bg"></div>
  </div>

  <!-- Content over parallax - split by diagonal -->
  <div class="relative z-10 min-h-screen flex flex-col justify-between px-4 sm:px-12 lg:px-16">
    <!-- Top left: Name -->
    <div class="mt-[20vh]">
      <h1 class="welcome-text text-6xl sm:text-7xl lg:text-8xl font-bold">
        Hey!<br />I'm <span class="styled-name">Ajay.</span>
      </h1>
    </div>

    <!-- Bottom right: Social buttons -->
    <div class="social-wrapper">
      <div class="social-buttons-container">
        <a 
          href="https://github.com/ajayraj" 
          target="_blank"
          rel="noopener noreferrer"
          class="social-button"
          aria-label="GitHub"
        >
          <img src="/img/GitHub-Mark-Light-64px.png" alt="GitHub" class="w-10 h-10" />
        </a>
        
        <a 
          href="mailto:ajay@ajayraj.co"
          class="social-button"
          aria-label="Email"
        >
          <img src="/img/at.svg" alt="Email" class="w-10 h-10 brightness-0 invert" />
        </a>
        
        <a 
          href="https://linkedin.com/in/ajayraj" 
          target="_blank"
          rel="noopener noreferrer"
          class="social-button"
          aria-label="LinkedIn"
        >
          <img src="/img/linkedin.svg" alt="LinkedIn" class="w-10 h-10 brightness-0 invert" />
        </a>
      </div>
    </div>
  </div>
  <!-- Subtle color transition overlay for the solid background area (bottom-right) -->
  <div class="color-transition-overlay"></div>
</section>

<style>
  .parallax-container {
    height: 100vh;
    width: 100%;
  }

  .parallax-bg {
    background-image: url(/img/isometric-green.svg);
    filter: saturate(200%) hue-rotate(-90deg) contrast(70%) invert();
    min-height: 100vh;
    width: 100%;
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    clip-path: polygon(0 0, 0% 100%, 100% 0);
  }

  .welcome-text {
    color: white;
  }

  .styled-name {
    font-size: 0.85em;
    font-weight: bold;
    background: linear-gradient(135deg, #ff8c42, #ffa07a);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .social-wrapper {
    position: absolute;
    bottom: 8vh;
    right: 5vw;
  }

  .social-buttons-container {
    display: flex;
    gap: 1.25rem;
  }

  .social-button {
    padding: 0.875rem;
    border-radius: 50%;
    background: rgba(68, 221, 101, 0.5);
    filter: hue-rotate(190deg) saturate(100%) brightness(150%);
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
  }

  .social-button:hover {
    transform: scale(1.1);
    filter: hue-rotate(190deg) saturate(150%) brightness(180%);
    box-shadow: 0 4px 12px rgba(190, 156, 212, 0.4);
  }

  @media (max-width: 768px) {
    .social-wrapper {
      left: 50%;
      transform: translateX(-50%);
      right: auto;
    }

    .social-buttons-container {
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .social-button {
      padding: 0.7rem;
    }

    .social-button img {
      width: 2rem !important;
      height: 2rem !important;
    }
  }

  @media (max-width: 640px) {
    .parallax-bg {
      background-attachment: scroll;
    }
  }

  .color-transition-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, transparent 0%, rgba(90, 90, 90, 0.15) 40%, rgba(90, 90, 90, 0.4) 75%, rgba(90, 90, 90, 0.95) 100%);
    clip-path: polygon(100% 0, 0% 100%, 100% 100%);
    pointer-events: none;
  }
</style>
